# Normalize line endings: keep shell scripts LF on every platform.
* text=auto eol=lf

*.sh            text eol=lf
bin/opencode-mlx-sandbox text eol=lf
install.sh      text eol=lf
entrypoint.sh   text eol=lf
Dockerfile      text eol=lf
*.md            text eol=lf
*.json          text eol=lf
*.jsonc         text eol=lf
.env.example    text eol=lf

# Keep spec/docs out of GitHub language stats; mark generated/vendored if added.
*.md            linguist-documentation

# Binary safety net
*.png           binary
*.jpg           binary
*.gz            binary